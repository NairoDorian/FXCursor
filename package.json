    "@types/node": "26.6.3",
    "bun-types": "1.4.3-canary.20260929T141505",
    "oxlint": "1.86.0",
    "prettier": "4.0.0-alpha.13",
    "repomix": "1.18.1",
    "typescript": "7.1.0-dev.20260929.1",
    "vite": "8.3.1"
  }
}
