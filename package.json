    "package:portable": "bun scripts/package-portable.ts",
    "before-commit": "bun scripts/before-commit.ts",
    "validate": "bun scripts/before-commit.ts --full",
    "arch": "bun scripts/generate-arch.ts",
    "docs:sync": "bun scripts/sync-docs.ts",
    "docs:check": "bun scripts/sync-docs.ts --check",
    "docs:find": "bun scripts/sync-docs.ts --find",
    "create-icons": "bun scripts/create-icons.ts",
    "update-deps": "bun scripts/update-deps.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.11",
    "@tauri-apps/api": "3.0.0-alpha.2",
