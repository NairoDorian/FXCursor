{
  "name": "fxcursor",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "test": "bun test",
