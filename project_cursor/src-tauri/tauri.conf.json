{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-v2-schema/main/src/tauri-conf.schema.json",
  "productName": "CursorFX",
  "version": "0.2.0",
  "identifier": "com.cursorfx.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CursorFX Config",
        "width": 420,
        "height": 620,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
