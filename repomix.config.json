{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": "ARCHITECTURE.md",
    "style": "markdown",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "includeEmptyDirectories": true
  },
  "include": ["**/*"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "dist/**",
      "target/**",
      "src-tauri/target/**",
      "node_modules/**",
      ".docs/**",
      ".system_generated/**",
      "*.log",
      "bun.lock",
      "Cargo.lock"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
